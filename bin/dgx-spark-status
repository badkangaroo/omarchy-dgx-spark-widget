        "name": "Tensorfold",
        "kind": "llm",
        "port": 8888,
        "paths": ("/health", "/v1/models", "/metrics"),
    },
    {
        "id": "comfyui",
        "name": "ComfyUI",
        "kind": "ui",
        "port": 3000,
        "paths": ("/",),
    },
    {
        "id": "ssh",
        "name": "SSH",
        "kind": "shell",
        "port": 22,
        "paths": (),
    },
)

REMOTE_METRICS_SCRIPT = r"""
import json, time
def cpu_sample():
    with open("/proc/stat") as f:
        parts = f.readline().split()
    vals = [int(x) for x in parts[1:]]
    idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
    return idle, sum(vals)

def mem_pct():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            bits = line.split()
            if len(bits) >= 2:
                info[bits[0].rstrip(":")] = int(bits[1])
    total = info.get("MemTotal", 0)
    avail = info.get("MemAvailable", 0)
    used = max(0, total - avail)
    pct = (used / total * 100.0) if total else 0.0
    return pct, used, total

i1, t1 = cpu_sample()
time.sleep(0.25)
i2, t2 = cpu_sample()
dt = max(t2 - t1, 1)
di = max(i2 - i1, 0)
cpu = max(0.0, min(100.0, (1.0 - (di / dt)) * 100.0))
mpct, mused, mtot = mem_pct()
out = {
    "cpuPct": round(cpu, 1),
    "memPct": round(mpct, 1),
    "memUsedKb": mused,
    "memTotalKb": mtot,
    "gpus": [],
}
print("METRICS_JSON:" + json.dumps(out, separators=(",", ":")))
"""


def load_config() -> dict[str, Any]:
    cfg = dict(DEFAULTS)
    if CONFIG_PATH.is_file():
        try:
            data = json.loads(CONFIG_PATH.read_text())
            if isinstance(data, dict):
                cfg.update(data)
        except (OSError, json.JSONDecodeError):
            pass
    return cfg


def save_config(cfg: dict[str, Any]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(cfg, indent=2) + "\n")
    try:
        CONFIG_PATH.chmod(0o600)
    except OSError:
        pass


def write_state(payload: dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(payload, indent=2) + "\n")


def load_history(limit: int) -> dict[str, list[float]]:
    empty = {"cpu": [], "gpu": [], "mem": []}
    if not HISTORY_PATH.is_file():
        return empty
    try:
        data = json.loads(HISTORY_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return empty
    out = empty
    for key in out:
        vals = data.get(key) if isinstance(data, dict) else None
        if isinstance(vals, list):
            cleaned = []
            for v in vals[-limit:]:
                try:
                    cleaned.append(float(v))
                except (TypeError, ValueError):
                    continue
            out[key] = cleaned
    return out


def push_history(history: dict[str, list[float]], sample: dict[str, Any], limit: int) -> dict[str, list[float]]:
    next_hist = {
        "cpu": list(history.get("cpu") or []),
        "gpu": list(history.get("gpu") or []),
        "mem": list(history.get("mem") or []),
    }
    mapping = {
        "cpu": sample.get("cpuPct"),
        "gpu": sample.get("gpuPct"),
        "mem": sample.get("memPct"),
    }
    for key, value in mapping.items():
        if value is None:
            continue
        try:
            next_hist[key].append(float(value))
        except (TypeError, ValueError):
            continue
        next_hist[key] = next_hist[key][-limit:]
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    HISTORY_PATH.write_text(json.dumps(next_hist) + "\n")
    return next_hist


def emit(payload: dict[str, Any], as_json: bool) -> int:
    write_state(payload)
    if as_json:
        json.dump(payload, sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        print_human(payload)
    return 0 if payload.get("ok") else 1


def print_human(payload: dict[str, Any]) -> None:
    conn = payload.get("connection") or {}
    print(f"ok={payload.get('ok')} transport={conn.get('transport')} host={conn.get('host')} method={conn.get('method')}")
    auth = payload.get("auth") or {}
    print(f"sshAuth={auth.get('ok')} target={auth.get('target')}")
    if auth.get("error"):
        print(f"ssh error: {auth['error']}")
    device = payload.get("device") or {}
    if device:
        print(
            f"device cpu={device.get('cpuPct')}% gpu={device.get('gpuPct')}% "
            f"mem={device.get('memPct')}% ({device.get('memUsedGb')}G/{device.get('memTotalGb')}G)"
        )
        for gpu in device.get("gpus") or []:
            print(
                f"  gpu[{gpu.get('index')}] {gpu.get('name')} "
                f"util={gpu.get('utilPct')}% vram={gpu.get('memUsedMb')}/{gpu.get('memTotalMb')}MB "
                f"clk={gpu.get('clockGraphicsMhz')}/{gpu.get('clockMemMhz')}MHz temp={gpu.get('tempC')}C"
            )
    if conn.get("error"):
        print(f"error: {conn['error']}")
    if conn.get("latencyMs") is not None:
        print(f"latency: {conn['latencyMs']} ms")
    for svc in payload.get("services") or []:
        print(f"  - {svc.get('name')}: {svc.get('status')} {svc.get('summary') or ''}".rstrip())
    rates = payload.get("ifaceRates")
    if rates and rates.get("ok"):
        print(
            f"iface {rates.get('iface')}: "
            f"↓ {format_rate(rates.get('rxBps'))}  ↑ {format_rate(rates.get('txBps'))}"
        )


def format_rate(bps: float | None) -> str:
    n = float(bps or 0)
    if n < 1024:
        return f"{n:.0f} B/s"
    if n < 1024 * 1024:
        return f"{n / 1024:.1f} KB/s"
    return f"{n / (1024 * 1024):.2f} MB/s"


def tcp_open(host: str, port: int, timeout: float) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def http_get(url: str, timeout: float) -> tuple[int | None, bytes, float]:
    started = time.monotonic()
    req = urllib.request.Request(url, headers={"User-Agent": "dgx-spark-status/0.2"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read()
            return resp.getcode(), body, (time.monotonic() - started) * 1000
    except urllib.error.HTTPError as exc:
        try:
            body = exc.read()
        except Exception:
            body = b""
        return exc.code, body, (time.monotonic() - started) * 1000
    except Exception:
        return None, b"", (time.monotonic() - started) * 1000


def resolve_host(name: str) -> list[str]:
    addrs: list[str] = []
    try:
        for info in socket.getaddrinfo(name, None, type=socket.SOCK_STREAM):
            ip = info[4][0]
            if ip not in addrs:
                addrs.append(ip)
    except socket.gaierror:
        pass
    return addrs


def ssh_identity_args(cfg: dict[str, Any]) -> list[str]:
    key = Path(str(cfg.get("sshKeyPath") or "")).expanduser()
    if key.is_file():
        return ["-i", str(key), "-o", "IdentitiesOnly=yes"]
    return []


def ssh_control_dir() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR", "").strip()
    if runtime:
        base = Path(runtime) / "dgx-spark-widget"
    else:
        base = Path.home() / ".cache" / "dgx-spark-widget"
    base.mkdir(parents=True, mode=0o700, exist_ok=True)
    try:
        base.chmod(0o700)
    except OSError:
        pass
    return base


def ssh_control_path_template(cfg: dict[str, Any]) -> str:
    """Short ControlPath template (%C keeps socket paths within unix limits)."""
    _ = cfg
    return str(ssh_control_dir() / "cm-%C")


def ssh_multiplex_options(cfg: dict[str, Any]) -> list[str]:
    persist = str(cfg.get("sshControlPersist") or DEFAULTS["sshControlPersist"])
    return [
        "-o",
        "ControlMaster=auto",
        "-o",
        f"ControlPath={ssh_control_path_template(cfg)}",
        "-o",
        f"ControlPersist={persist}",
    ]


def ssh_common_options(cfg: dict[str, Any], timeout: float) -> list[str]:
    return [
        *ssh_identity_args(cfg),
        "-o",
        "BatchMode=yes",
        "-o",
        f"ConnectTimeout={max(1, int(timeout))}",
        "-o",
        "StrictHostKeyChecking=accept-new",
    ]


def ssh_base_cmd(
    cfg: dict[str, Any], target: str, timeout: float, *, multiplex: bool = True
) -> list[str]:
    cmd = ["ssh", *ssh_common_options(cfg, timeout)]
    if multiplex:
        cmd.extend(ssh_multiplex_options(cfg))
    cmd.append(target)
    return cmd


def ssh_resolved_control_path(cfg: dict[str, Any], target: str, timeout: float) -> str | None:
    cmd = ["ssh", *ssh_common_options(cfg, timeout), *ssh_multiplex_options(cfg), "-G", target]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in (proc.stdout or "").splitlines():
        if line.startswith("controlpath "):
            return line.split(" ", 1)[1].strip()
    return None


def ssh_master_alive(cfg: dict[str, Any], target: str, timeout: float) -> bool:
    cmd = [
        "ssh",
        *ssh_common_options(cfg, timeout),
        *ssh_multiplex_options(cfg),
        "-O",
        "check",
        target,
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 5)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return proc.returncode == 0


def ssh_master_exit(cfg: dict[str, Any], target: str, timeout: float) -> None:
    cmd = [
        "ssh",
        *ssh_common_options(cfg, timeout),
        *ssh_multiplex_options(cfg),
        "-O",
        "exit",
        target,
    ]
    try:
        subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def remove_stale_control_socket(cfg: dict[str, Any], target: str, timeout: float) -> None:
    path = ssh_resolved_control_path(cfg, target, timeout)
    if not path:
        return
    sock = Path(path)
    try:
        if sock.exists():
            sock.unlink()
    except OSError:
        pass


def multiplex_close_targets(cfg: dict[str, Any], host_override: str | None = None) -> list[str]:
    """SSH targets used for -O exit — same host resolution as status ticks."""
    if host_override and str(host_override).strip():
        return [preferred_ssh_target(cfg, str(host_override).strip())]
    conn = connect(cfg)
    if conn.get("ok") and conn.get("host"):
        return [preferred_ssh_target(cfg, str(conn["host"]))]
    return [preferred_ssh_target(cfg)]


def ssh_master_exit_control_path(
    cfg: dict[str, Any], sock_path: Path, target: str, timeout: float
) -> bool:
    cmd = [
        "ssh",
        *ssh_common_options(cfg, timeout),
        "-S",
        str(sock_path),
        "-O",
        "exit",
        target,
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 5)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return proc.returncode == 0


def sweep_control_dir_sockets(cfg: dict[str, Any], targets: list[str], timeout: float) -> int:
    """Safety net: exit or remove every cm-* control socket under the widget dir."""
    closed = 0
    ctrl = ssh_control_dir()
    fallback = targets[0] if targets else preferred_ssh_target(cfg)
    try_targets = targets if targets else [fallback]
    for entry in sorted(ctrl.glob("cm-*")):
        if not entry.exists():
            continue
        handled = False
        for target in try_targets:
            if ssh_master_exit_control_path(cfg, entry, target, timeout):
                handled = True
                break
        if not handled:
            try:
                entry.unlink()
                handled = True
            except OSError:
                pass
        if handled:
            closed += 1
    return closed


def close_multiplex_sessions(cfg: dict[str, Any], host_override: str | None = None) -> dict[str, Any]:
    timeout = float(cfg.get("connectTimeoutSec") or 2.0)
    targets = multiplex_close_targets(cfg, host_override)
    for target in targets:
        ssh_master_exit(cfg, target, timeout)
        remove_stale_control_socket(cfg, target, timeout)
    sockets_closed = sweep_control_dir_sockets(cfg, targets, timeout)
    return {"targets": targets, "socketsClosed": sockets_closed}


def is_ssh_reauth_error(result: dict[str, Any]) -> bool:
    rc = result.get("returncode")
    if rc == 255:
        return True
    err = f"{result.get('stderr') or ''}\n{result.get('error') or ''}".lower()
    if "permission denied" in err:
        return True
    if "authentication failed" in err or "auth fail" in err:
        return True
    return False


def preferred_ssh_target(cfg: dict[str, Any], host: str | None = None) -> str:
    user = str(cfg.get("sshUser") or "").strip()
    configured = str(cfg.get("sshTarget") or "").strip()
    if configured and "@" in configured:
        cfg_user, cfg_host = configured.split("@", 1)
        if not user:
            user = cfg_user
        if not host:
            host = cfg_host
    if host:
        host = str(host).strip()
        if "@" in host:
            return host
        if not user:
            user = "alex"
        return f"{user}@{host}"
    if configured:
        return configured
    fallback_host = str(
        cfg.get("host")
        or cfg.get("tailscaleIp")
        or cfg.get("tailscaleHost")
        or cfg.get("mdnsHost")
        or ""
    )
    if not fallback_host:
        return f"{user}@spark"
    if not user:
        user = "alex"
    return f"{user}@{fallback_host}"


def candidate_targets(cfg: dict[str, Any], prefer: str) -> list[dict[str, str]]:
    out: list[dict[str, str]] = []

    def add(transport: str, host: str, label: str) -> None:
        host = (host or "").strip()
        if not host:
            return
        key = (transport, host)
        if any((c["transport"], c["host"]) == key for c in out):
            return
        out.append({"transport": transport, "host": host, "label": label})

    order = {
        "auto": ["iface", "tailscale", "ssh"],
        "iface": ["iface", "tailscale", "ssh"],
        "tailscale": ["tailscale", "iface", "ssh"],
        "ssh": ["ssh", "iface", "tailscale"],
    }.get(prefer, ["iface", "tailscale", "ssh"])

    for kind in order:
        if kind == "iface":
            add("iface", str(cfg.get("host") or ""), "configured host")
            add("iface", str(cfg.get("mdnsHost") or ""), "mDNS")
        elif kind == "tailscale":
            add("tailscale", str(cfg.get("tailscaleIp") or ""), "Tailscale IP")
            add("tailscale", str(cfg.get("tailscaleHost") or ""), "Tailscale name")
        elif kind == "ssh":
            target = preferred_ssh_target(cfg)
            host = target.split("@", 1)[1] if "@" in target else target
            add("ssh", host, "SSH target host")
    return out


def probe_http_ready(host: str, port: int, timeout: float) -> dict[str, Any]:
    url = f"http://{host}:{port}/health"
    code, body, ms = http_get(url, timeout)
    if code == 200:
        try:
            data = json.loads(body.decode("utf-8", "replace"))
        except json.JSONDecodeError:
            data = {}
        return {"ok": True, "url": url, "latencyMs": round(ms, 1), "health": data}

    models_url = f"http://{host}:{port}/v1/models"
    code2, body2, ms2 = http_get(models_url, timeout)
    if code2 == 200:
        try:
            data = json.loads(body2.decode("utf-8", "replace"))
        except json.JSONDecodeError:
            data = {}
        return {"ok": True, "url": models_url, "latencyMs": round(ms2, 1), "models": data}

    return {
        "ok": False,
        "url": url,
        "latencyMs": round(ms, 1),
        "tcpOpen": tcp_open(host, port, timeout),
        "httpCode": code,
    }


def ssh_run(
    cfg: dict[str, Any],
    target: str,
    remote: str,
    timeout: float,
    *,
    allow_retry: bool = True,
) -> dict[str, Any]:
    cmd = [*ssh_base_cmd(cfg, target, timeout), remote]
    started = time.monotonic()
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 8)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "target": target, "error": str(exc), "returncode": None}
    ms = (time.monotonic() - started) * 1000
    out = (proc.stdout or "").strip()
    err = (proc.stderr or "").strip()
    ok = proc.returncode == 0
    result = {
        "ok": ok,
        "target": target,
        "latencyMs": round(ms, 1),
        "stdout": out,
        "stderr": err,
        "returncode": proc.returncode,
        "error": None if ok else (err.splitlines()[-1] if err else f"ssh exit {proc.returncode}"),
    }
    if ok or not allow_retry or not is_ssh_reauth_error(result):
        return result
    reason = result.get("error") or f"exit {result.get('returncode')}"
    note_tick_reauth(str(reason))
    note_tick_session(reused=False)
    ssh_master_exit(cfg, target, timeout)
    remove_stale_control_socket(cfg, target, timeout)
    return ssh_run(cfg, target, remote, timeout, allow_retry=False)


def ssh_auth_status(
    cfg: dict[str, Any], host: str | None = None, *, skip_if_master: bool = False
) -> dict[str, Any]:
    target = preferred_ssh_target(cfg, host)
    timeout = float(cfg.get("connectTimeoutSec") or 2.0)
    if skip_if_master and ssh_master_alive(cfg, target, timeout):
        return {
            "ok": True,
            "target": target,
            "keyPath": str(cfg.get("sshKeyPath") or ""),
            "latencyMs": 0.0,
            "detail": "multiplex session active",
            "error": None,
        }
    result = ssh_run(cfg, target, "echo OK; hostname; whoami", timeout)
    return {
        "ok": bool(result.get("ok")) and (result.get("stdout") or "").startswith("OK"),
        "target": target,
        "keyPath": str(cfg.get("sshKeyPath") or ""),
        "latencyMs": result.get("latencyMs"),
        "detail": result.get("stdout"),
        "error": None if result.get("ok") else result.get("error"),
    }


def ensure_ssh_key(key_path: Path) -> Path:
    key_path.parent.mkdir(parents=True, exist_ok=True)
    if key_path.is_file():
        return key_path
    subprocess.run(
        [
            "ssh-keygen",
            "-t",
            "ed25519",
            "-f",
            str(key_path),
            "-N",
            "",
            "-C",
            "omarchy-dgx-spark-widget",
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    try:
        key_path.chmod(0o600)
        Path(str(key_path) + ".pub").chmod(0o644)
    except OSError:
        pass
    return key_path


def _mktemp_path(prefix: str, suffix: str = "") -> Path:
    # mkstemp returns an open fd; leaving it open makes Linux refuse to exec the
    # askpass script ("Text file busy"), so password auth silently fails.
    fd, name = tempfile.mkstemp(prefix=prefix, suffix=suffix, dir=str(STATE_DIR))
    os.close(fd)
    return Path(name)


def askpass_env(password: str) -> tuple[dict[str, str], Path, Path]:
    """Create a short-lived askpass helper. Password lives in a 0600 file, not argv."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    pass_file = _mktemp_path("dgx-spark-pass-")
    ask_file = _mktemp_path("dgx-spark-ask-", suffix=".sh")
    # No trailing newline — ssh uses the askpass output as the password bytes.
    pass_file.write_bytes(password.encode("utf-8"))
    pass_file.chmod(0o600)
    ask_file.write_text(
        "#!/bin/sh\n"
        f"exec cat {json.dumps(str(pass_file))}\n"
    )
    ask_file.chmod(0o700)
    env = dict(os.environ)
    env["SSH_ASKPASS"] = str(ask_file)
    env["SSH_ASKPASS_REQUIRE"] = "force"
    # ssh requires DISPLAY (or WAYLAND_DISPLAY) before it will call SSH_ASKPASS.
    env.setdefault("DISPLAY", os.environ.get("DISPLAY") or ":0")
    if os.environ.get("WAYLAND_DISPLAY"):
        env.setdefault("WAYLAND_DISPLAY", os.environ["WAYLAND_DISPLAY"])
    return env, pass_file, ask_file


def cleanup_askpass(pass_file: Path, ask_file: Path | None = None) -> None:
    for path in (pass_file, ask_file):
        if path is None:
            continue
        try:
            path.unlink(missing_ok=True)
        except TypeError:
            try:
                if path.exists():
                    path.unlink()
            except OSError:
                pass
        except OSError:
            pass


def ssh_password_cmd(cfg: dict[str, Any], target: str) -> list[str]:
    timeout = max(1, int(cfg.get("connectTimeoutSec") or 2))
    return [
        "ssh",
        "-o",
        "StrictHostKeyChecking=accept-new",
        "-o",
        "PreferredAuthentications=password,keyboard-interactive",
        "-o",
        "PubkeyAuthentication=no",
        "-o",
        "PasswordAuthentication=yes",
        "-o",
        "KbdInteractiveAuthentication=yes",
        "-o",
        "NumberOfPasswordPrompts=1",
        "-o",
        f"ConnectTimeout={timeout}",
        target,
    ]


def friendly_auth_error(raw: str, target: str) -> str:
    text = (raw or "").strip()
    low = text.lower()
    if "permission denied" in low:
        return (
            f"Wrong username or password for {target}. "
            "The Spark accepted neither the typed password nor a key yet."
        )
    if "connection refused" in low:
        return f"SSH connection refused by {target}"
    if "timed out" in low or "connection timed out" in low:
        return f"SSH timed out contacting {target}"
    if "no route" in low or "network is unreachable" in low:
        return f"Host unreachable: {target}"
    if not text:
        return f"SSH authentication failed for {target}"
    # Keep the last line — usually the actionable OpenSSH summary.
    return text.splitlines()[-1]


def install_ssh_key(cfg: dict[str, Any], user: str, host: str, password: str) -> dict[str, Any]:
    user = (user or "").strip()
    host = (host or "").strip()
    if not user:
        return {"ok": False, "error": "username required"}
    if not host:
        return {"ok": False, "error": "host required"}
    if password == "":
        return {"ok": False, "error": "password required"}

    key_path = ensure_ssh_key(Path(str(cfg.get("sshKeyPath") or DEFAULTS["sshKeyPath"])).expanduser())
    pub_path = Path(str(key_path) + ".pub")
    target = f"{user}@{host}"
    env, pass_file, ask_file = askpass_env(password)
    try:
        # 1) Prove the password works before touching authorized_keys.
        probe = subprocess.run(
            [*ssh_password_cmd(cfg, target), "echo DGX_SPARK_AUTH_OK"],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            env=env,
            timeout=30,
        )
        if probe.returncode != 0 or "DGX_SPARK_AUTH_OK" not in (probe.stdout or ""):
            raw = (probe.stderr or probe.stdout or "").strip()
            return {
                "ok": False,
                "target": target,
                "error": friendly_auth_error(raw, target),
                "stderr": raw.splitlines()[-3:],
            }

        # 2) Install the local widget key using the verified password.
        #    Pass the pubkey as base64 in the remote script so ssh stdin stays
        #    free for askpass (feeding the key on stdin breaks password auth).
        #    Important: pass ONE remote command string. ssh joins argv with
        #    spaces and does not re-quote, so `bash -lc <script>` would turn
        #    into `bash -lc mkdir ...` and mkdir would run with no args.
        pubkey = pub_path.read_text().strip()
        pubkey_b64 = base64.b64encode((pubkey + "\n").encode("utf-8")).decode("ascii")
        install_remote = (
            "mkdir -p ~/.ssh && chmod 700 ~/.ssh && "
            "touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && "
            f"echo {shlex.quote(pubkey_b64)} | base64 -d >> ~/.ssh/authorized_keys && "
            "sort -u ~/.ssh/authorized_keys -o ~/.ssh/authorized_keys"
        )
        install = subprocess.run(
            [*ssh_password_cmd(cfg, target), install_remote],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            env=env,
            timeout=30,
        )
        if install.returncode != 0:
            raw = (install.stderr or install.stdout or "failed to install SSH key").strip()
            return {
                "ok": False,
                "target": target,
                "error": friendly_auth_error(raw, target),
                "phase": "install-key",
            }
    finally:
        cleanup_askpass(pass_file, ask_file)

    cfg = dict(cfg)
    cfg["sshUser"] = user
    cfg["sshTarget"] = target
    cfg["sshKeyPath"] = str(key_path)
    if not cfg.get("host"):
        cfg["host"] = host
    save_config(cfg)

    verify = ssh_auth_status(cfg, host)
    if not verify.get("ok"):
        return {
            "ok": False,
            "target": target,
            "error": verify.get("error")
            or "Password worked, but key login still failed. Check ~/.ssh/authorized_keys on the Spark.",
            "verify": verify,
        }
    return {"ok": True, "target": target, "keyPath": str(key_path), "verify": verify}


def connect(cfg: dict[str, Any]) -> dict[str, Any]:
    prefer = str(cfg.get("transport") or "auto")
    timeout = float(cfg.get("connectTimeoutSec") or 2.0)
    llm_port = int(cfg.get("llmPort") or 8888)
    attempts: list[dict[str, Any]] = []
    weak: dict[str, Any] | None = None

    for cand in candidate_targets(cfg, prefer):
        transport = cand["transport"]
        host = cand["host"]
        attempt: dict[str, Any] = {
            "transport": transport,
            "host": host,
            "label": cand["label"],
        }

        if transport == "ssh":
            if tcp_open(host, 22, timeout):
                attempt["tcpOpen"] = True
                attempts.append(attempt)
                return {
                    "ok": True,
                    "transport": "ssh",
                    "method": "ssh",
                    "host": host,
                    "label": cand["label"],
                    "latencyMs": None,
                    "attempts": attempts,
                }
            attempt["tcpOpen"] = False
            attempt["error"] = "SSH port closed"
            attempts.append(attempt)
            continue

        resolved = resolve_host(host)
        probe_hosts = resolved or [host]
        for probe_host in probe_hosts:
            if probe_host.startswith("fe80:") and len(probe_hosts) > 1:
                continue
            http = probe_http_ready(probe_host, llm_port, timeout)
            attempt_http = dict(attempt)
            attempt_http["probeHost"] = probe_host
            attempt_http.update(http)
            attempts.append(attempt_http)
            if http.get("ok"):
                base = str(cfg.get("llmBaseUrl") or "").strip() or f"http://{probe_host}:{llm_port}/v1"
                return {
                    "ok": True,
                    "transport": transport,
                    "method": "http",
                    "host": probe_host,
                    "requestedHost": host,
                    "label": cand["label"],
                    "latencyMs": http.get("latencyMs"),
                    "llmBaseUrl": base.rstrip("/"),
                    "health": http.get("health"),
                    "models": http.get("models"),
                    "attempts": attempts,
                }
            if http.get("tcpOpen") and weak is None:
                weak = {
                    "ok": True,
                    "transport": transport,
                    "method": "tcp",
                    "host": probe_host,
                    "requestedHost": host,
                    "label": cand["label"],
                    "latencyMs": http.get("latencyMs"),
                    "llmBaseUrl": f"http://{probe_host}:{llm_port}/v1",
                    "warning": "TCP open but HTTP health/models failed",
                    "attempts": attempts,
                }

    if weak:
        return weak

    return {
        "ok": False,
        "transport": None,
        "method": None,
        "host": None,
        "error": "no reachable transport",
        "attempts": attempts,
    }


def iface_counters(iface: str) -> dict[str, int] | None:
    base = Path("/sys/class/net") / iface / "statistics"
    try:
        return {
            "rx": int((base / "rx_bytes").read_text().strip()),
            "tx": int((base / "tx_bytes").read_text().strip()),
        }
    except (OSError, ValueError):
        return None


def sample_iface_rates(iface: str, dwell: float = 0.35) -> dict[str, Any] | None:
    if not iface:
        return None
    a = iface_counters(iface)
    if not a:
        return {"iface": iface, "ok": False, "error": "iface missing or unreadable"}
    time.sleep(dwell)
    b = iface_counters(iface)
    if not b:
        return {"iface": iface, "ok": False, "error": "iface disappeared"}
    dt = max(dwell, 1e-6)
    return {
        "iface": iface,
        "ok": True,
        "rxBps": (b["rx"] - a["rx"]) / dt,
        "txBps": (b["tx"] - a["tx"]) / dt,
        "rxBytes": b["rx"],
        "txBytes": b["tx"],
    }


def discover_services(
    cfg: dict[str, Any], conn: dict[str, Any], ssh_auth: dict[str, Any] | None = None
) -> list[dict[str, Any]]:
    host = conn.get("host")
    if not host:
        return []
    timeout = float(cfg.get("connectTimeoutSec") or 2.0)
    services: list[dict[str, Any]] = []

    for probe in SERVICE_PROBES:
        port = int(probe["port"])
        svc: dict[str, Any] = {
            "id": probe["id"],
            "name": probe["name"],
            "kind": probe["kind"],
            "port": port,
            "status": "closed",
        }
        if not tcp_open(str(host), port, timeout):
            services.append(svc)
            continue

        svc["status"] = "open"
        if probe["id"] == "ssh":
            if ssh_auth is not None:
                ssh = ssh_auth
            else:
                ssh = ssh_auth_status(cfg, str(host), skip_if_master=True)
            svc["sshOk"] = bool(ssh.get("ok"))
            svc["summary"] = "auth ok" if ssh.get("ok") else (ssh.get("error") or "listening")
            services.append(svc)
            continue

        summaries: list[str] = []
        for path in probe["paths"]:
            url = f"http://{host}:{port}{path}"
            code, body, ms = http_get(url, timeout)
            if code is None:
                continue
            entry = {"path": path, "httpCode": code, "latencyMs": round(ms, 1)}
            text = body.decode("utf-8", "replace")
            if path == "/health" and code == 200:
                try:
                    health = json.loads(text)
                    svc["health"] = health
                    bits = []
                    if health.get("backend"):
                        bits.append(str(health["backend"]))
                    if health.get("busy"):
                        bits.append("busy")
                    running = health.get("requests_running")
                    if running is not None:
                        bits.append(f"{running} running")
                    comp = float(health.get("completion_tokens_total") or 0)
                    dec_s = float(health.get("decode_seconds_total") or 0)
                    if dec_s > 0:
                        tps = comp / dec_s
                        svc["decodeTokPerSec"] = round(tps, 1)
                        bits.append(f"{tps:.1f} tok/s")
                    summaries.append(" ".join(bits))
                    entry["ok"] = True
                except json.JSONDecodeError:
                    entry["ok"] = False
            elif path == "/v1/models" and code == 200:
                try:
                    models = json.loads(text)
                    ids = [m.get("id") for m in (models.get("data") or []) if isinstance(m, dict)]
                    svc["models"] = ids
                    if ids:
                        summaries.append("models: " + ", ".join(ids))
                    entry["ok"] = True
                except json.JSONDecodeError:
                    entry["ok"] = False
            elif path == "/metrics" and code == 200:
                svc["metricsBytes"] = len(body)
                entry["ok"] = True
            elif path == "/" and code == 200:
                if "ComfyUI" in text:
                    summaries.append("ComfyUI UI")
                    svc["product"] = "ComfyUI"
                entry["ok"] = True
            svc.setdefault("probes", []).append(entry)

        svc["url"] = f"http://{host}:{port}"
        svc["summary"] = "; ".join(s for s in summaries if s) or "listening"
        services.append(svc)

    return services


def parse_nvidia_smi(text: str) -> list[dict[str, Any]]:
    gpus: list[dict[str, Any]] = []
    for index, line in enumerate(text.splitlines()):
        line = line.strip()
        if not line or line.startswith("METRICS_JSON:"):
            continue
        parts = [p.strip() for p in line.split(",")]
        if len(parts) < 7:
            continue
        try:
            gpus.append(
                {
                    "index": index,
                    "name": parts[0],
                    "utilPct": float(parts[1]),
                    "memUtilPct": float(parts[2]),
                    "memUsedMb": float(parts[3]),
                    "memTotalMb": float(parts[4]),
                    "clockGraphicsMhz": float(parts[5]),
                    "clockMemMhz": float(parts[6]),
                    "tempC": float(parts[7]) if len(parts) > 7 else None,
                }
            )
        except ValueError:
            continue
    return gpus


def collect_device_metrics(cfg: dict[str, Any], host: str | None) -> dict[str, Any]:
    _auth, device = collect_auth_and_device_metrics(cfg, host, tick_session=False)
    return device


def metrics_remote_command(*, include_auth_header: bool) -> str:
    header = ""
    if include_auth_header:
        header = "echo OK; hostname; whoami\n"
    return (
        header
        + "python3 - <<'PY'\n"
        + REMOTE_METRICS_SCRIPT
        + "PY\n"
        + "nvidia-smi --query-gpu=name,utilization.gpu,utilization.memory,memory.used,memory.total,clocks.gr,clocks.mem,temperature.gpu --format=csv,noheader,nounits 2>/dev/null || true\n"
    )


def auth_from_metrics_stdout(
    cfg: dict[str, Any], target: str, stdout: str, latency_ms: float | None, *, ok: bool, error: str | None
) -> dict[str, Any]:
    base = {
        "target": target,
        "keyPath": str(cfg.get("sshKeyPath") or ""),
        "latencyMs": latency_ms,
        "error": error,
    }
    text = stdout or ""
    if ok and text.startswith("OK"):
        lines = text.splitlines()
        return {**base, "ok": True, "detail": "\n".join(lines[:3]) if len(lines) >= 3 else text.split("\n", 1)[0]}
    if ok:
        return {**base, "ok": True, "detail": "multiplex session active", "error": None}
    return {**base, "ok": False, "detail": None}


def collect_auth_and_device_metrics(
    cfg: dict[str, Any], host: str | None, *, tick_session: bool = True
) -> tuple[dict[str, Any], dict[str, Any] | None]:
    target = preferred_ssh_target(cfg, host)
    timeout = max(4.0, float(cfg.get("connectTimeoutSec") or 2.0) + 2.0)
    conn_timeout = float(cfg.get("connectTimeoutSec") or 2.0)
    master = ssh_master_alive(cfg, target, conn_timeout)
    if tick_session:
        note_tick_session(reused=master)
    remote = metrics_remote_command(include_auth_header=not master)
    result = ssh_run(cfg, target, remote, timeout)
    if not result.get("ok"):
        auth = auth_from_metrics_stdout(
            cfg,
            target,
            result.get("stdout") or "",
            result.get("latencyMs"),
            ok=False,
            error=result.get("error"),
        )
        return auth, {"ok": False, "error": result.get("error"), "target": target}

    stdout = result.get("stdout") or ""
    auth = auth_from_metrics_stdout(
        cfg, target, stdout, result.get("latencyMs"), ok=True, error=None
    )
    base: dict[str, Any] = {"ok": True, "target": target, "gpus": []}
    for line in stdout.splitlines():
        if line.startswith("METRICS_JSON:"):
            try:
                base.update(json.loads(line[len("METRICS_JSON:") :]))
            except json.JSONDecodeError:
                pass
    gpus = parse_nvidia_smi(stdout)
    base["gpus"] = gpus
    if gpus:
        base["gpuPct"] = gpus[0].get("utilPct")
        base["gpuMemPct"] = (
            round(100.0 * float(gpus[0]["memUsedMb"]) / float(gpus[0]["memTotalMb"]), 1)
            if gpus[0].get("memTotalMb")
            else gpus[0].get("memUtilPct")
        )
        base["gpuName"] = gpus[0].get("name")
        base["gpuTempC"] = gpus[0].get("tempC")
        base["clockGraphicsMhz"] = gpus[0].get("clockGraphicsMhz")
        base["clockMemMhz"] = gpus[0].get("clockMemMhz")
    if base.get("memTotalKb"):
        base["memUsedGb"] = round(float(base["memUsedKb"]) / (1024 * 1024), 1)
        base["memTotalGb"] = round(float(base["memTotalKb"]) / (1024 * 1024), 1)
    if not auth.get("ok"):
        base["ok"] = False
        base["error"] = auth.get("error") or "SSH auth failed"
    return auth, base


def live_tok_per_sec(host: str, port: int, timeout: float, dwell: float = 0.8) -> float | None:
    url = f"http://{host}:{port}/health"
    c1, b1, _ = http_get(url, timeout)
    if c1 != 200:
        return None
    try:
        a = json.loads(b1.decode("utf-8", "replace"))
    except json.JSONDecodeError:
        return None
    time.sleep(dwell)
    c2, b2, _ = http_get(url, timeout)
    if c2 != 200:
        return None
    try:
        b = json.loads(b2.decode("utf-8", "replace"))
    except json.JSONDecodeError:
        return None
    delta = float(b.get("completion_tokens_total") or 0) - float(a.get("completion_tokens_total") or 0)
    return round(max(0.0, delta / dwell), 1)


def build_status(cfg: dict[str, Any], with_rates: bool = True, with_live_tok: bool = True) -> dict[str, Any]:
    conn = connect(cfg)
    host = conn.get("host")
    auth: dict[str, Any] = {
        "ok": False,
        "target": preferred_ssh_target(cfg, str(host) if host else None),
        "keyPath": str(cfg.get("sshKeyPath") or ""),
        "error": "not connected",
    }
    device = None
    history = load_history(int(cfg.get("historyPoints") or 30))
    if conn.get("ok"):
        auth, device = collect_auth_and_device_metrics(cfg, str(host) if host else None)
        if device and device.get("ok"):
            history = push_history(
                history,
                {
                    "cpuPct": device.get("cpuPct"),
                    "gpuPct": device.get("gpuPct"),
                    "memPct": device.get("memPct"),
                },
                int(cfg.get("historyPoints") or 30),
            )

    services = discover_services(cfg, conn, ssh_auth=auth if conn.get("ok") else None) if conn.get("ok") else []
    rates = sample_iface_rates(str(cfg.get("iface") or "")) if with_rates else None

    llm = next((s for s in services if s.get("id") == "tensorfold" and s.get("health")), None)
    if with_live_tok and llm and host:
        live = live_tok_per_sec(str(host), int(cfg.get("llmPort") or 8888), float(cfg.get("connectTimeoutSec") or 2.0))
        if live is not None:
            llm["liveTokPerSec"] = live

    return {
        "ok": bool(conn.get("ok")),
        "ts": time.time(),
        "connection": conn,
        "auth": auth,
        "device": device,
        "history": history,
        "services": services,
        "ifaceRates": rates,
        "config": {
            "transport": cfg.get("transport"),
            "iface": cfg.get("iface"),
            "host": cfg.get("host"),
            "tailscaleHost": cfg.get("tailscaleHost"),
            "sshTarget": cfg.get("sshTarget"),
            "sshUser": cfg.get("sshUser"),
            "llmPort": cfg.get("llmPort"),
        },
    }


def cmd_init_config(_: argparse.Namespace) -> int:
    cfg = load_config()
    save_config(cfg)
    print(f"wrote {CONFIG_PATH}")
    return 0


def cmd_connect(args: argparse.Namespace) -> int:
    cfg = load_config()
    if args.transport:
        cfg["transport"] = args.transport
    conn = connect(cfg)
    auth = ssh_auth_status(cfg, conn.get("host"))
    payload = {"ok": bool(conn.get("ok")), "ts": time.time(), "connection": conn, "auth": auth}
    return emit(payload, args.json)


def cmd_discover(args: argparse.Namespace) -> int:
    cfg = load_config()
    if args.transport:
        cfg["transport"] = args.transport
    payload = build_status(cfg, with_rates=False, with_live_tok=False)
    return emit(payload, args.json)


def cmd_status(args: argparse.Namespace) -> int:
    reset_tick_debug()
    mark_status_tick()
    cfg = load_config()
    if args.transport:
        cfg["transport"] = args.transport
    payload = build_status(cfg, with_rates=not args.no_rates, with_live_tok=not args.fast)
    code = emit(payload, args.json)
    flush_tick_debug_log()
    return code


def cmd_auth_status(args: argparse.Namespace) -> int:
    cfg = load_config()
    auth = ssh_auth_status(cfg, args.host)
    payload = {"ok": bool(auth.get("ok")), "ts": time.time(), "auth": auth}
    return emit(payload, args.json)


def cmd_auth(args: argparse.Namespace) -> int:
    cfg = load_config()
    # One line only: the Omarchy Process helper writes stdin but does not
    # close it, so read()-until-EOF hangs forever in the panel.
    # Prefer a JSON payload so username/host come from the form fields,
    # not a stale config default (session user).
    line = sys.stdin.readline()
    if line.endswith("\n"):
        line = line[:-1]
    if line.endswith("\r"):
        line = line[:-1]

    user = (args.user or "").strip()
    host = (args.host or "").strip()
    password = ""
    try:
        payload_in = json.loads(line) if line.startswith("{") else None
    except json.JSONDecodeError:
        payload_in = None
    if isinstance(payload_in, dict):
        user = str(payload_in.get("user") or user).strip()
        host = str(payload_in.get("host") or host).strip()
        password = str(payload_in.get("password") or "")
    else:
        password = line

    if not user:
        user = str(cfg.get("sshUser") or "").strip()
    if not host:
        host = str(cfg.get("host") or cfg.get("tailscaleHost") or "").strip()
    if not user:
        return emit(
            {
                "ok": False,
                "ts": time.time(),
                "auth": {"ok": False, "error": "username required"},
            },
            True,
        )

    result = install_ssh_key(cfg, user, host, password)
    payload = {"ok": bool(result.get("ok")), "ts": time.time(), "auth": result}
    return emit(payload, True)


def cmd_logout(_: argparse.Namespace) -> int:
    """Forget SSH target binding in config (does not delete the key file)."""
    cfg = load_config()
    close_multiplex_sessions(cfg)
    cfg["sshTarget"] = ""
    # Keep user/key path so reconnect is easy; auth-status will fail until re-auth
    # if the remote key was revoked. Locally we only clear the remembered target.
    save_config(cfg)
    # Clear history so graphs don't look live for a stale session.
    try:
        HISTORY_PATH.unlink(missing_ok=True)
    except TypeError:
        if HISTORY_PATH.exists():
            HISTORY_PATH.unlink()
    except OSError:
        pass
    payload = {"ok": True, "ts": time.time(), "auth": {"ok": False, "error": "logged out"}}
    return emit(payload, True)


def cmd_close_session(args: argparse.Namespace) -> int:
    """Close the OpenSSH multiplex master (testing / manual session reset)."""
    cfg = load_config()
    host_override = (args.host or "").strip() or None
    closed = close_multiplex_sessions(cfg, host_override=host_override)
    targets = closed.get("targets") or []
    target = targets[0] if targets else preferred_ssh_target(cfg, host_override)
    sockets_closed = int(closed.get("socketsClosed") or 0)
    if _debug_log_enabled():
        append_debug_line(f"CLOSE_SESSION {sockets_closed} sockets")
    payload = {
        "ok": True,
        "ts": time.time(),
        "auth": {
            "ok": False,
            "error": "session closed",
            "target": target,
            "targets": targets,
            "socketsClosed": sockets_closed,
        },
    }
    return emit(payload, args.json)


def main() -> int:
    parser = argparse.ArgumentParser(description="DGX Spark Status collector")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument(
        "--debug-log",
        metavar="FILE",
        default="",
        help="append secret-free multiplex session lines (or set DGX_SPARK_WIDGET_DEBUG=1)",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init-config", help="write default config")
    p_init.set_defaults(func=cmd_init_config)

    p_conn = sub.add_parser("connect", help="probe transport ladder")
    p_conn.add_argument("--transport", choices=["auto", "iface", "tailscale", "ssh"])
    p_conn.add_argument("--json", action="store_true")
    p_conn.set_defaults(func=cmd_connect)

    p_disc = sub.add_parser("discover", help="connect and list services")
    p_disc.add_argument("--transport", choices=["auto", "iface", "tailscale", "ssh"])
    p_disc.add_argument("--json", action="store_true")
    p_disc.set_defaults(func=cmd_discover)

    p_stat = sub.add_parser("status", help="full status snapshot for the widget")
    p_stat.add_argument("--transport", choices=["auto", "iface", "tailscale", "ssh"])
    p_stat.add_argument("--no-rates", action="store_true")
    p_stat.add_argument("--fast", action="store_true", help="skip live tok/s dwell")
    p_stat.add_argument("--json", action="store_true")
    p_stat.set_defaults(func=cmd_status)

    p_auth = sub.add_parser("auth", help="install SSH key using password on stdin")
    p_auth.add_argument("--user", default="")
    p_auth.add_argument("--host", default="")
    p_auth.set_defaults(func=cmd_auth)

    p_auth_status = sub.add_parser("auth-status", help="check BatchMode SSH")
    p_auth_status.add_argument("--host", default="")
    p_auth_status.add_argument("--json", action="store_true")
    p_auth_status.set_defaults(func=cmd_auth_status)

    p_logout = sub.add_parser("logout", help="clear remembered SSH target")
    p_logout.set_defaults(func=cmd_logout)

    p_close = sub.add_parser("close-session", help="close SSH multiplex master (ssh -O exit)")
    p_close.add_argument("--host", default="")
    p_close.add_argument("--json", action="store_true")
    p_close.set_defaults(func=cmd_close_session)

    args = parser.parse_args()
    init_debug_logging(args.debug_log or None)
    if getattr(args, "json", False) is False and "--json" in sys.argv:
        args.json = True
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())
