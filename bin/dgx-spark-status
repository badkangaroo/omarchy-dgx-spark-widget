#!/usr/bin/env python3
"""DGX Spark Status Widget collector.

Probes reachability (iface/LAN → Tailscale → SSH), discovers HTTP services,
handles one-shot SSH key auth (password via stdin only), and samples
CPU / GPU / memory for the panel sparklines.
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import shlex
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

DEFAULTS: dict[str, Any] = {
    "transport": "auto",  # auto | iface | tailscale | ssh
    "iface": "",  # local NIC for UP/DOWN rates; empty = skip rates
    "host": "",  # LAN / direct IP or hostname
    "mdnsHost": "",  # e.g. spark-xxxx.local
    "tailscaleHost": "",  # MagicDNS short name
    "tailscaleIp": "",  # 100.x address
    "sshTarget": "",
    "sshUser": "",
    "sshKeyPath": str(Path.home() / ".ssh" / "id_ed25519_dgx_spark"),
    "llmPort": 8888,
    "llmBaseUrl": "",
    "connectTimeoutSec": 2.0,
    "sshControlPersist": "10m",
    "historyPoints": 30,
    "ports": [22, 3000, 8888],
}

CONFIG_DIR = Path.home() / ".config" / "omarchy" / "dgx-spark-widget"
CONFIG_PATH = CONFIG_DIR / "config.json"
STATE_DIR = Path.home() / ".local" / "state" / "omarchy" / "dgx-spark-widget"
STATE_PATH = STATE_DIR / "status.json"
HISTORY_PATH = STATE_DIR / "history.json"

# Opt-in tick logging (never includes secrets).
_debug_log_path: Path | None = None
_tick_debug: dict[str, Any] = {}


def _debug_log_enabled() -> bool:
    return _debug_log_path is not None


def configure_debug_log(path: Path | None) -> None:
    global _debug_log_path
    _debug_log_path = path


def reset_tick_debug() -> None:
    _tick_debug.clear()


def note_tick_reauth(reason: str) -> None:
    _tick_debug["reauth"] = reason


def note_tick_session(*, reused: bool) -> None:
    _tick_debug["reused"] = reused


def mark_status_tick() -> None:
    """Only status polls should emit NEW_LOGIN/REUSED tick lines."""
    _tick_debug["tick"] = True


def append_debug_line(message: str) -> None:
    if not _debug_log_path:
        return
    ts = time.strftime("%Y-%m-%dT%H:%M:%S")
    line = f"{ts} {message}\n"
    try:
        _debug_log_path.parent.mkdir(parents=True, exist_ok=True)
        with _debug_log_path.open("a", encoding="utf-8") as fh:
            fh.write(line)
    except OSError:
        pass


def flush_tick_debug_log() -> None:
    if not _debug_log_path or not _tick_debug.get("tick"):
        return
    reused = bool(_tick_debug.get("reused"))
    if _tick_debug.get("reauth"):
        reused = False
    ts = time.strftime("%Y-%m-%dT%H:%M:%S")
    parts = [ts]
    if _tick_debug.get("reauth"):
        parts.append(f"REAUTH after {_tick_debug['reauth']}")
    parts.append("REUSED" if reused else "NEW_LOGIN")
    line = " ".join(parts) + "\n"
    try:
        _debug_log_path.parent.mkdir(parents=True, exist_ok=True)
        with _debug_log_path.open("a", encoding="utf-8") as fh:
            fh.write(line)
    except OSError:
        pass


def init_debug_logging(debug_log: str | None = None) -> None:
    if debug_log:
        configure_debug_log(Path(debug_log).expanduser())
        return
    if os.environ.get("DGX_SPARK_WIDGET_DEBUG") == "1":
        configure_debug_log(STATE_DIR / "widget-debug.log")


SERVICE_PROBES = (
